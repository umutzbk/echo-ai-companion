{
  "expo": {
    "name": "Echo",
    "slug": "echo-companion",
    "scheme": "echo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://192.168.1.174:4000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.echo.companion"
    }
  }
}
