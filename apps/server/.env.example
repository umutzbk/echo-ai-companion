# ── Echo server environment ──────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Server
PORT=4000
NODE_ENV=development

# Database (Postgres) — matches docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://echo:echo@localhost:5433/echo?schema=public"

# Anthropic — if unset, the server uses the deterministic MockProvider so the
# whole stack still runs without a key. Keys must NEVER ship in the mobile client.
ANTHROPIC_API_KEY=
MODEL_DEEP=claude-opus-4-8
MODEL_LIGHT=claude-haiku-4-5-20251001

# Logging — keep "redact" on; raw message content is never logged regardless.
LOG_LEVEL=info
